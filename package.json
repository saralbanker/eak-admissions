{
  "name": "eak-admissions",
  "version": "1.0.0",
  "private": true,
  "description": "EAK International School - Admissions landing page (Session 2027-28)",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o css/styles.css --minify",
    "build:js": "node scripts/build-js.mjs",
    "build:fonts": "node scripts/copy-fonts.mjs",
    "build:pdf": "node scripts/make-prospectus.mjs",
    "build": "npm run build:fonts && npm run build:css && npm run build:js && npm run build:pdf",
    "watch:css": "tailwindcss -i src/input.css -o css/styles.css --watch",
    "serve": "npx --yes serve ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "esbuild": "^0.28.2",
    "pdfkit": "^0.15.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/cli": "^4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
